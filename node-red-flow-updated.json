        "name": "Get LED State & Respond",
        "func": "// Get the current LED state from context (default OFF)\nlet ledState = context.get('ledState') || 'OFF';\n\n// Send LED state back to Photon2 in HTTP response\nmsg.payload = {\n    led: ledState,\n    status: 'ok'\n};\n\nreturn msg;",
