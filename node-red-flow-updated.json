    {
        "id": "4b5c6d7e8f901234",
        "type": "function",
        "z": "be5ba68c1080fbfd",
        "name": "Store LED State",
        "func": "// Parse the incoming LED command\nlet ledCommand = msg.payload.led;\n\n// Store the LED state in context so it can be sent to Photon2\ncontext.set('ledState', ledCommand);\n\nnode.status({fill: ledCommand === 'ON' ? 'green' : 'grey', shape: 'dot', text: 'LED: ' + ledCommand});\n\n// Keep original payload for debugging\nreturn msg;",
